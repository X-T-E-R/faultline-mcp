{
    "name": "xterstudio/faultline-mcp",
    "description": "Faultline MCP — Deterministic Chaos Proxy & Idempotency Flight Recorder for Symfony AI & PHP MCP Agents",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "laminas/laminas-httphandlerrunner": "^2.12",
        "mcp/sdk": "^0.10.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-hugging-face-platform": "^1.0@beta",
        "symfony/ai-mcp-tool": "dev-main",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/cache": "^7.3",
        "symfony/clock": "^7.3",
        "symfony/config": "^7.3",
        "symfony/console": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "symfony/finder": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-client": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/http-kernel": "^7.3",
        "symfony/lock": "^7.3",
        "symfony/mcp-bundle": "dev-main",
        "symfony/process": "^7.3",
        "symfony/psr-http-message-bridge": "^7.3",
        "symfony/routing": "^7.3",
        "symfony/uid": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.32",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Faultline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Faultline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse src tests --level=6"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
